{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "web",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/public/", "permanent": false },
    { "source": "/web/:path*/", "destination": "/:path*/", "permanent": false },
    { "source": "/web/:path*", "destination": "/:path*", "permanent": false }
  ]
}
